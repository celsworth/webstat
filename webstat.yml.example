# Webstat configuration example
# Copy to webstat.yml and adjust for your environment.

# Display name shown in the HTML reports
site_name: "My Site"

# Comma-separated log file/glob patterns
# Each entry can be a single file or a wildcard glob.
log_glob: /var/log/nginx/access.log,/dump/logs/access*

# SQLite database path (will be created if absent)
database: /var/lib/webstat/webstat.db

# Directory where static HTML reports are written
output_dir: /var/www/webstat

# Path to the MaxMind GeoLite2-Country .mmdb file (optional)
# Leave blank to disable GeoIP lookup
geoip_db: /etc/webstat/GeoLite2-Country.mmdb

# Periodic checkpoint interval in minutes.
# 0 disables intermediate checkpoints (flush only at end of run).
checkpoint_minutes: 0

# Number of rows in top-N tables
top_n: 20

# Run SQLite VACUUM after pruning (can be expensive on large DBs)
vacuum_after_prune: false

# Exclude known bots/crawlers from main statistics
bot_filter: true

# Track top URLs/hosts/referrers/agents (disable to go faster and reduce processing CPU/memory if not required)
enable_top_urls: true
enable_top_hosts: true
enable_top_refs: true
enable_top_agents: true

# Rule-based filtering
# Rules are evaluated in the parser thread in order; the first matching rule wins.
# See RULES.md for full field/operator reference.
#
rules:
  - name: "Ignore redirects"
    enabled: false
    when:
      - field: status
        op: between
        value: [301, 308]
    action: ignore

  - name: "Ignore static assets"
    enabled: false
    when:
      any:
        - field: url
          op: starts_with
          value: "/static/"
        - field: url
          op: starts_with
          value: "/assets/"
        - field: url
          op: ends_with
          value: ".ico"
    action: ignore

  - name: "Hide self-referrals from top refs"
    enabled: false
    when:
      any:
        - field: referer
          op: contains
          value: site-name
        - field: referer
          op: contains
          value: alternate-site-name
    action:
      hide: [refs]

  - name: "Ignore common scanner paths"
    enabled: false
    when:
      any:
        - field: url
          op: starts_with
          value: "/wp-"
        - field: url
          op: starts_with
          value: "/wp-admin"
        - field: url
          op: contains
          value: "phpMyAdmin"
        - field: url
          op: contains
          value: ".php"
        - field: url
          op: contains
          value: ".env"
        - field: url
          op: contains
          value: "/.git"
    action: ignore

  - name: "Ignore suspiciously long URLs"
    enabled: false
    when:
      - field: url
        op: len_gt
        value: 500
    action: ignore

  - name: "Ignore suspiciously long UA"
    enabled: false
    when:
      - field: user_agent
        op: len_gt
        value: 400
    action: ignore

  - name: "Ignore suspiciously long referer"
    enabled: false
    when:
      - field: referer
        op: len_gt
        value: 300
    action: ignore
