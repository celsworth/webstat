# Webstat configuration example
# Copy to webstat.yml and adjust for your environment.

# Display name shown in the HTML reports
site_name: "My Site"

# Comma-separated log file/glob patterns
# Each entry can be a single file or a wildcard glob.
log_glob: /var/log/nginx/access.log,/dump/logs/access*

# SQLite database path (will be created if absent)
database: /var/lib/webstat/webstat.db

# Directory where static HTML reports are written
output_dir: /var/www/webstat

# Path to the MaxMind GeoLite2-Country .mmdb file (optional)
# Leave blank to disable GeoIP lookup
geoip_db: /etc/webstat/GeoLite2-Country.mmdb

# Periodic checkpoint interval in minutes.
# 0 disables intermediate checkpoints (flush only at end of run).
checkpoint_minutes: 0

# Number of rows in top-N tables
top_n: 20

# Run SQLite VACUUM after pruning (can be expensive on large DBs)
vacuum_after_prune: false

# Exclude known bots/crawlers from main statistics
bot_filter: true

# Track top URLs/hosts/referrers/agents (disable to go faster and reduce processing CPU/memory if not required)
enable_top_urls: true
enable_top_hosts: true
enable_top_refs: true
enable_top_agents: true

# Track all-time unique hosts in the all_time_ips table.
# Disable to save space — this table can grow very large on high-traffic sites.
# When disabled, the Unique Sites box is hidden on the overview report.
enable_all_time_unique_hosts: true

# HTML report colour overrides.
# Any key omitted uses the built-in default. Overrides apply to both light and dark mode.

style:
  # Theme
  bg: "#eef1f5"
  surface: "#ffffff"
  surface_alt: "#f4f6fa"
  border: "#d7dce5"
  text: "#1f2532"
  text_muted: "#60697a"
  accent: "#2f61d4"
  accent_hover: "#244ca7"

  # Metric UI colours (stat card borders, table header text)
  metric_hits: "#52c493"
  metric_files: "#7090ff"
  metric_pages: "#66ddff"
  metric_visits: "#bfa800"
  metric_sites: "#ffc055"
  metric_bandwidth: "#ff7a7a"

  # Status table row background tints
  status_2xx_bg: "#52c49324"
  status_3xx_bg: "#7090ff24"
  status_4xx_bg: "#ffc0552e"
  status_5xx_bg: "#ff7a7a29"
  status_other_bg: "#a0a0a01f"
  weekend_bg: "#2f61d414"

  # Chart bar / line colours
  bar_hits: "#52c493"
  bar_hits_weekend: "#5bb4b3"
  bar_visits: "#ffea66"
  bar_visits_weekend: "#d4cf94"
  bar_sites: "#ffc055"
  bar_sites_weekend: "#d4b288"
  line_bandwidth: "#ff7a7a"

  # Status doughnut chart colours
  status_2xx_color: "#52c493"
  status_3xx_color: "#7090ff"
  status_4xx_color: "#ffc055"
  status_5xx_color: "#ff7a7a"
  status_other_color: "#bab0ac"

# Rule-based filtering
# Rules are evaluated in the parser thread in order; the first matching rule wins.
# See RULES.md for full field/operator reference.
#
rules:
  - name: "Ignore redirects"
    enabled: false
    when:
      - field: status
        op: between
        value: [301, 308]
    action: ignore

  - name: "Ignore static assets"
    enabled: false
    when:
      any:
        - field: url
          op: starts_with
          value: "/static/"
        - field: url
          op: starts_with
          value: "/assets/"
        - field: url
          op: ends_with
          value: ".ico"
    action: ignore

  - name: "Hide self-referrals from top refs"
    enabled: false
    when:
      any:
        - field: referer
          op: contains
          value: site-name
        - field: referer
          op: contains
          value: alternate-site-name
    action:
      hide: [refs]

  - name: "Ignore common scanner paths"
    enabled: false
    when:
      any:
        - field: url
          op: starts_with
          value: "/wp-"
        - field: url
          op: starts_with
          value: "/wp-admin"
        - field: url
          op: contains
          value: "phpMyAdmin"
        - field: url
          op: contains
          value: ".php"
        - field: url
          op: contains
          value: ".env"
        - field: url
          op: contains
          value: "/.git"
    action: ignore

  - name: "Ignore suspiciously long URLs"
    enabled: false
    when:
      - field: url
        op: len_gt
        value: 500
    action: ignore

  - name: "Ignore suspiciously long UA"
    enabled: false
    when:
      - field: user_agent
        op: len_gt
        value: 400
    action: ignore

  - name: "Ignore suspiciously long referer"
    enabled: false
    when:
      - field: referer
        op: len_gt
        value: 300
    action: ignore
