<div class="page-header">
  <h2>{{ year }} - Annual Summary</h2>
</div>

<section class="summary-bar">
  <div class="stat-card stat-card--hits">
    <span class="stat-value" title="{{ totals.hits_exact_fmt }}">{{ totals.hits_fmt }}</span>
    <span class="stat-label">Total Hits</span>
  </div>
  <div class="stat-card stat-card--visits">
    <span class="stat-value" title="{{ totals.visits_exact_fmt }}">{{ totals.visits_fmt }}</span>
    <span class="stat-label">Total Visits</span>
  </div>
  <div class="stat-card stat-card--sites">
    <span class="stat-value" title="{{ totals.visitors_exact_fmt }}">{{ totals.visitors_fmt }}</span>
    <span class="stat-label">Unique Sites</span>
  </div>
  <div class="stat-card stat-card--bandwidth">
    <span class="stat-value">{{ totals.bandwidth_fmt }}</span>
    <span class="stat-label">Bandwidth</span>
  </div>
  {% if totals.avg_rt_ms %}
  <div class="stat-card stat-card--rt">
    <span class="stat-value">{{ totals.avg_rt_ms }}</span>
    {% if totals.p95_rt_ms %}<span class="stat-sub">p95: {{ totals.p95_rt_ms }}</span>{% endif %}
    <span class="stat-label">Avg Response Time</span>
  </div>
  {% endif %}
</section>

<section class="charts-col">
  <div class="charts-split">
    <div class="chart-box chart-box--bar">
      <canvas id="overviewChart"></canvas>
    </div>
    <div class="chart-box chart-box--bar">
      <canvas id="overviewVisitsChart"></canvas>
    </div>
  </div>
  {% if rt_over_time_chart is defined %}
  <div class="chart-box chart-box--bar">
    <canvas id="rtOverTimeChart"></canvas>
  </div>
  {% endif %}
</section>

{% if status_codes | length > 0 or top_countries_hits | length > 0 or top_countries_bandwidth | length > 0 or top_agents_hits | length > 0 or top_agents_bandwidth | length > 0 %}
<section class="charts-col">
  <div class="charts-triple">
    {% if status_codes | length > 0 %}
    <div class="chart-box">
      <canvas id="statusChart"></canvas>
    </div>
    {% endif %}
    {% if top_countries_hits | length > 0 or top_countries_bandwidth | length > 0 %}
    <div class="chart-box">
      <canvas id="countriesChart"></canvas>
    </div>
    {% endif %}
    {% if top_agents_hits | length > 0 or top_agents_bandwidth | length > 0 %}
    <div class="chart-box">
      <canvas id="agentsChart"></canvas>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="stats-group">
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="6" class="stats-panel__heading">Monthly Breakdown</th></tr>
      <tr>
        <th>Month</th>
        <th class="num-col metric-hits">Hits</th>
        <th class="num-col metric-visits">Visits</th>
        <th class="num-col metric-sites">Sites</th>
        <th class="num-col metric-bandwidth">Bandwidth</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      {% for row in monthly_rows %}
      <tr>
        <td>{{ row.month_name }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
        <td class="num-col" data-value="{{ row.visits }}" title="{{ row.visits_exact_fmt }}">{{ row.visits_fmt }}</td>
        <td class="num-col" data-value="{{ row.visitors }}" title="{{ row.visitors_exact_fmt }}">{{ row.visitors_fmt }}</td>
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
        <td><a href="../{{ row.period }}/index.html" class="btn-link">View -></a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</section>

<section class="stats-group">
  <div class="stats-panel">
    {% if status_codes | length > 0 %}
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th colspan="2" class="stats-panel__heading">Hits by Response Code</th></tr>
      </thead>
      <tbody>
        {% for s in status_codes %}
        <tr class="{% if s.status >= 200 and s.status < 300 %}status-row--2xx{% elif s.status >= 300 and s.status < 400 %}status-row--3xx{% elif s.status >= 400 and s.status < 500 %}status-row--4xx{% elif s.status >= 500 and s.status < 600 %}status-row--5xx{% else %}status-row--other{% endif %}">
          <td>{{ s.label }}</td>
          <td class="num-col" title="{{ s.hits_exact_fmt }}"><span class="pct-value">({{ s.pct_fmt }})</span> {{ s.hits_fmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>

  <div class="stats-panel">
    {% if proto_codes | length > 0 %}
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th colspan="2" class="stats-panel__heading">Hits by Protocol</th></tr>
      </thead>
      <tbody>
        {% for p in proto_codes %}
        <tr>
          <td>{{ p.proto }}</td>
          <td class="num-col" title="{{ p.hits_exact_fmt }}"><span class="pct-value">({{ p.pct_fmt }})</span> {{ p.hits_fmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>

  <div class="stats-panel">
    {% if method_codes | length > 0 %}
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th colspan="2" class="stats-panel__heading">Hits by Method</th></tr>
      </thead>
      <tbody>
        {% for m in method_codes %}
        <tr>
          <td>{{ m.method }}</td>
          <td class="num-col" title="{{ m.hits_exact_fmt }}"><span class="pct-value">({{ m.pct_fmt }})</span> {{ m.hits_fmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
</section>

{% if top_urls_hits | length > 0 or top_urls_bandwidth | length > 0 or top_slow_urls | length > 0 %}
<div class="stats-panel" data-tabs>
  <div class="tab-group-header">
    <span class="tab-group-title" data-tabs-title></span>
    <div data-tabs-nav>
      {% if top_urls_hits | length > 0 %}
      <button class="tab-btn" data-tabs-target="top-urls-hits" data-tabs-label="Top URLs by Hits">Hits</button>
      {% endif %}
      {% if top_urls_bandwidth | length > 0 %}
      <button class="tab-btn" data-tabs-target="top-urls-bandwidth" data-tabs-label="Top URLs by Bandwidth">Bandwidth</button>
      {% endif %}
      {% if top_slow_urls | length > 0 %}
      <button class="tab-btn" data-tabs-target="top-urls-rt" data-tabs-label="Top URLs by Response Time">Response Time</button>
      {% endif %}
    </div>
  </div>

  {% if top_urls_hits | length > 0 %}
  <div id="top-urls-hits" data-tabs-panel>
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th>#</th><th>URL</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th><th class="num-col">Avg RT</th><th class="num-col">Max RT</th></tr>
      </thead>
      <tbody>
        {% for row in top_urls_hits %}
        <tr>
          <td>{{ loop.index }}</td>
          <td class="url-cell">{{ row.url }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">
            <span class="pct-value">({{ row.pct_fmt }})</span> {{ row.hits_fmt }}
          </td>
          <td class="num-col" data-value="{{ row.bandwidth }}">
            <span class="pct-value">({{ row.bandwidth_pct_fmt }})</span> {{ row.bandwidth_fmt }}
          </td>
          <td class="num-col">{{ row.avg_ms_fmt | default(value="—") }}</td>
          <td class="num-col">{{ row.max_ms_fmt | default(value="—") }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if top_urls_bandwidth | length > 0 %}
  <div id="top-urls-bandwidth" data-tabs-panel>
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th>#</th><th>URL</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th><th class="num-col">Avg RT</th><th class="num-col">Max RT</th></tr>
      </thead>
      <tbody>
        {% for row in top_urls_bandwidth %}
        <tr>
          <td>{{ loop.index }}</td>
          <td class="url-cell">{{ row.url }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">
            <span class="pct-value">({{ row.pct_fmt }})</span> {{ row.hits_fmt }}
          </td>
          <td class="num-col" data-value="{{ row.bandwidth }}">
            <span class="pct-value">({{ row.bandwidth_pct_fmt }})</span> {{ row.bandwidth_fmt }}
          </td>
          <td class="num-col">{{ row.avg_ms_fmt | default(value="—") }}</td>
          <td class="num-col">{{ row.max_ms_fmt | default(value="—") }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if top_slow_urls | length > 0 %}
  <div id="top-urls-rt" data-tabs-panel>
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th>#</th><th>URL</th>
        <th class="num-col">Hits</th>
        <th class="num-col">Bandwidth</th>
        <th class="num-col">Avg RT</th>
        <th class="num-col">Max RT</th>
        </tr>
      </thead>
      <tbody>
        {% for row in top_slow_urls %}
        <tr>
          <td>{{ loop.index }}</td>
          <td class="url-cell">{{ row.url }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
          <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
          <td class="num-col">{{ row.avg_ms_fmt | default(value="—") }}</td>
          <td class="num-col">{{ row.max_ms_fmt | default(value="—") }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>
{% endif %}

{% if top_ips_hits | length > 0 or top_ips_bandwidth | length > 0 %}
<div class="stats-panel" data-tabs>
  <div class="tab-group-header">
    <span class="tab-group-title" data-tabs-title></span>
    <div data-tabs-nav>
      {% if top_ips_hits | length > 0 %}
      <button class="tab-btn" data-tabs-target="top-ips-hits" data-tabs-label="Top Sites by Hits">Hits</button>
      {% endif %}
      {% if top_ips_bandwidth | length > 0 %}
      <button class="tab-btn" data-tabs-target="top-ips-bandwidth" data-tabs-label="Top Sites by Bandwidth">Bandwidth</button>
      {% endif %}
    </div>
  </div>

  {% if top_ips_hits | length > 0 %}
  <div id="top-ips-hits" data-tabs-panel>
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th>#</th><th>Site</th><th>Country</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
      </thead>
      <tbody>
        {% for row in top_ips_hits %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ row.host }}</td>
          <td>{{ row.country_flag }} {{ row.country_name }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">
            <span class="pct-value">({{ row.pct_fmt }})</span> {{ row.hits_fmt }}
          </td>
          <td class="num-col" data-value="{{ row.bandwidth }}">
            <span class="pct-value">({{ row.bandwidth_pct_fmt }})</span> {{ row.bandwidth_fmt }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if top_ips_bandwidth | length > 0 %}
  <div id="top-ips-bandwidth" data-tabs-panel>
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th>#</th><th>Site</th><th>Country</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
      </thead>
      <tbody>
        {% for row in top_ips_bandwidth %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ row.host }}</td>
          <td>{{ row.country_flag }} {{ row.country_name }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">
            <span class="pct-value">({{ row.pct_fmt }})</span> {{ row.hits_fmt }}
          </td>
          <td class="num-col" data-value="{{ row.bandwidth }}">
            <span class="pct-value">({{ row.bandwidth_pct_fmt }})</span> {{ row.bandwidth_fmt }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>
{% endif %}

{% if top_refs | length > 0 %}
<section class="stats-group">
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="3" class="stats-panel__heading">Top Referrers</th></tr>
      <tr><th>#</th><th>Referrer</th><th class="num-col">Hits</th></tr>
    </thead>
    <tbody>
      {% for row in top_refs %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell"><a href="{{ row.referrer }}" rel="noopener noreferrer" target="_blank">{{ row.referrer }}</a></td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</section>
{% endif %}

<script>
(function() {
  new Chart(document.getElementById('overviewChart'), {{ overview_chart | safe }});
  new Chart(document.getElementById('overviewVisitsChart'), {{ overview_visits_chart | safe }});
  var statusCanvas = document.getElementById('statusChart');
  if (statusCanvas) {
    new Chart(statusCanvas, {{ status_chart | safe }});
  }
  var countriesCanvas = document.getElementById('countriesChart');
  if (countriesCanvas) {
    new Chart(countriesCanvas, {{ country_chart | safe }});
  }
  var agentsCanvas = document.getElementById('agentsChart');
  if (agentsCanvas) {
    new Chart(agentsCanvas, {{ agents_chart | safe }});
  }
  {% if rt_over_time_chart is defined %}
  var rtCanvas = document.getElementById('rtOverTimeChart');
  if (rtCanvas) { new Chart(rtCanvas, {{ rt_over_time_chart | safe }}); }
  {% endif %}
})();
</script>
