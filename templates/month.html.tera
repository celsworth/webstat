        <td data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</section>
-->

<section class="stats-group">
  <div class="stats-panel">
    {% if top_agents | length > 0 %}
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th colspan="4" class="stats-panel__heading">Browser Families</th></tr>
        <tr><th>#</th><th>Browser Family</th><th class="num-col">Hits</th><th class="num-col">% of Total</th></tr>
      </thead>
      <tbody>
        {% for row in top_agents %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ row.agent }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
          <td class="num-col">{{ row.pct_fmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>

  <div class="stats-panel">
    {% if top_countries | length > 0 %}
    <table class="data-table stats-panel__table">
      <thead>
        <tr><th colspan="4" class="stats-panel__heading">Top Countries</th></tr>
        <tr><th>#</th><th>Country</th><th class="num-col">Hits</th><th class="num-col">% of Total</th></tr>
      </thead>
      <tbody>
        {% for row in top_countries %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ row.country_flag }} {{ row.country_name }}</td>
          <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
          <td class="num-col">{{ row.pct_fmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
</section>

{% if top_urls_hits | length > 0 or top_urls_bandwidth | length > 0 %}
<div class="paired-tables-grid">
{% if top_urls_hits | length > 0 %}
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="4" class="stats-panel__heading">Top URLs by Hits</th></tr>
      <tr><th>#</th><th>URL</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
    </thead>
    <tbody>
      {% for row in top_urls_hits %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell">{{ row.url }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if top_urls_bandwidth | length > 0 %}
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="4" class="stats-panel__heading">Top URLs by Bandwidth</th></tr>
      <tr><th>#</th><th>URL</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
    </thead>
    <tbody>
      {% for row in top_urls_bandwidth %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell">{{ row.url }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
</div>
{% endif %}

{% if top_slow_urls | length > 0 %}
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="4" class="stats-panel__heading">Slowest Endpoints (avg response time)</th></tr>
      <tr><th>#</th><th>URL</th><th class="num-col">Avg</th><th class="num-col">P95</th></tr>
    </thead>
    <tbody>
      {% for row in top_slow_urls %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell">{{ row.url }}</td>
        <td class="num-col">{{ row.avg_ms_fmt }}</td>
        <td class="num-col">{{ row.p95_ms_fmt | default(value="—") }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if top_ips_hits | length > 0 or top_ips_bandwidth | length > 0 %}
<div class="paired-tables-grid">
{% if top_ips_hits | length > 0 %}
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="5" class="stats-panel__heading">Top Sites by Hits</th></tr>
      <tr><th>#</th><th>Site</th><th>Country</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
    </thead>
    <tbody>
      {% for row in top_ips_hits %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ row.host }}</td>
        <td>{{ row.country_flag }} {{ row.country_name }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if top_ips_bandwidth | length > 0 %}
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="5" class="stats-panel__heading">Top Sites by Bandwidth</th></tr>
      <tr><th>#</th><th>Site</th><th>Country</th><th class="num-col">Hits</th><th class="num-col">Bandwidth</th></tr>
    </thead>
    <tbody>
      {% for row in top_ips_bandwidth %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ row.host }}</td>
        <td>{{ row.country_flag }} {{ row.country_name }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
</div>
{% endif %}

{% if top_refs | length > 0 %}
<section class="stats-group">
<div class="stats-panel">
  <table class="data-table stats-panel__table">
    <thead>
      <tr><th colspan="3" class="stats-panel__heading">Top Referrers</th></tr>
      <tr><th>#</th><th>Referrer</th><th class="num-col">Hits</th></tr>
    </thead>
    <tbody>
      {% for row in top_refs %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell"><a href="{{ row.referrer }}" rel="noopener noreferrer" target="_blank">{{ row.referrer }}</a></td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">{{ row.hits_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</section>
{% endif %}

<script>
(function() {
  new Chart(document.getElementById('dailyChart'), {{ daily_chart | safe }});
  new Chart(document.getElementById('dailyVisitsChart'), {{ daily_visits_chart | safe }});
  new Chart(document.getElementById('hourlyChart'), {{ hourly_chart | safe }});
  var statusCanvas = document.getElementById('statusChart');
  if (statusCanvas) {
    new Chart(statusCanvas, {{ status_chart | safe }});
  }
  var agentsCanvas = document.getElementById('agentsChart');
  if (agentsCanvas) {
    new Chart(agentsCanvas, {{ agents_chart | safe }});
  }
  var countriesCanvas = document.getElementById('countriesChart');
  if (countriesCanvas) {
    new Chart(countriesCanvas, {{ country_chart | safe }});
  }
  {% if rt_over_time_chart is defined %}
  var rtCanvas = document.getElementById('rtOverTimeChart');
  if (rtCanvas) { new Chart(rtCanvas, {{ rt_over_time_chart | safe }}); }
  {% endif %}
  {% if rt_distribution_chart is defined %}
  var rtDistCanvas = document.getElementById('rtDistributionChart');
  if (rtDistCanvas) { new Chart(rtDistCanvas, {{ rt_distribution_chart | safe }}); }
  {% endif %}
})();
</script>
