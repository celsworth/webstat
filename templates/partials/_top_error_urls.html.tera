{# Top erroring URLs. Single table with client-side column-header sort.
   Columns are driven by `error_url_columns` (configured codes plus "4xx"/"5xx"
   catch-alls). On the overview page (err_collapsible=true) the outer element is a
   <details> with the panel styling. On monthly/yearly the panel wraps an inner
   <details> matching the Daily/Hourly Statistics pattern. #}
{% if top_error_urls | length > 0 %}
{% if err_collapsible | default(value=false) %}
<details class="stats-panel collapsible-section">
  <summary>Top Erroring URLs</summary>
{% else %}
<div class="stats-panel">
  <details class="collapsible-section">
    <summary>Top Erroring URLs</summary>
    <div class="collapsible-section__body">
{% endif %}
  <div style="overflow-x:auto">
  <table class="data-table stats-panel__table" id="err-url-table">
    <thead>
      <tr>
        <th>#</th>
        <th>URL</th>
        {% for col in error_url_columns %}
        <th class="num-col" data-col="{{ loop.index0 + 2 }}" title="Sort by {{ col.label }}">{{ col.label }}</th>
        {% endfor %}
        <th class="num-col" data-col="{{ error_url_columns | length + 2 }}" title="Sort by bandwidth">BW</th>
      </tr>
    </thead>
    <tbody>
      {% for row in top_error_urls %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell">{{ row.url }}</td>
        {% for cell in row.cells %}
        <td class="num-col" data-value="{{ cell.value }}">{{ cell.fmt }}</td>
        {% endfor %}
        <td class="num-col" data-value="{{ row.bandwidth }}">{{ row.bandwidth_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <script>makeSortable('err-url-table', -1, {{ top_n }});</script>
{% if err_collapsible | default(value=false) %}
</details>
{% else %}
    </div>
  </details>
</div>
{% endif %}
{% endif %}
