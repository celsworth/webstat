{# Requires tab_prefix to be set before include, e.g. {% set tab_prefix = "top" %} #}
{% if top_urls | length > 0 %}
<div class="stats-panel" id="{{ tab_prefix }}-urls-panel">
  <table class="data-table stats-panel__table" id="{{ tab_prefix }}-urls-table">
    <thead>
      <tr>
        <th>#</th>
        <th>URL</th>
        <th class="num-col" data-col="2">Hits</th>
        <th class="num-col" data-col="3">Bandwidth</th>
        <th class="num-col" data-col="4">Avg RT</th>
        <th class="num-col" data-col="5">Max RT</th>
      </tr>
    </thead>
    <tbody>
      {% for row in top_urls %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="url-cell">{{ row.url }}</td>
        <td class="num-col" data-value="{{ row.hits }}" title="{{ row.hits_exact_fmt }}">
          <span class="pct-value">({{ row.pct_fmt }})</span> {{ row.hits_fmt }}
        </td>
        <td class="num-col" data-value="{{ row.bandwidth }}">
          <span class="pct-value">({{ row.bandwidth_pct_fmt }})</span> {{ row.bandwidth_fmt }}
        </td>
        <td class="num-col" data-value="{{ row.avg_ms_raw | default(value=0) }}">{{ row.avg_ms_fmt | default(value="—") }}</td>
        <td class="num-col" data-value="{{ row.max_ms_raw }}">{{ row.max_ms_fmt | default(value="—") }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <script>makeSortable('{{ tab_prefix }}-urls-table', 2, {{ top_n }});</script>
</div>
{% endif %}
